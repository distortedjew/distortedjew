# Wisp — environment configuration
# Copy this file to .env and fill in real values for local development.
# Never commit .env with real secrets.

# --- Core ---
NODE_ENV=development
PORT=3000
# The address you open Wisp at in your browser. If that's not localhost
# (e.g. a remote server: http://203.0.113.5:3000), set it here — otherwise
# the dev server blocks the browser's connection and nothing is clickable.
APP_URL=http://localhost:3000
# Extra hostnames allowed to use the dev server (comma-separated), if you
# open it from more than one address. Not needed in production.
ALLOWED_DEV_ORIGINS=

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://wisp:wisp@localhost:5432/wisp?schema=public

# --- Redis (matchmaking, presence, rate limiting, ephemeral state) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-32-byte-base64-secret
AUTH_COOKIE_NAME=wisp_session
GUEST_SESSION_TTL_DAYS=30
AUTH_SESSION_TTL_DAYS=30

# --- WebRTC / STUN / TURN ---
# Comma-separated list of STUN servers.
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN is required for reliable P2P behind restrictive NATs/firewalls.
# Leave blank in dev; the app falls back to STUN-only (best effort).
TURN_SERVER=
# Preferred: a secret shared with coturn (use-auth-secret), so each user
# gets their own login that expires after 12 hours.
TURN_SECRET=
# Fallback for hosted TURN services with one fixed login. Ignored when
# TURN_SECRET is set.
TURN_USERNAME=
TURN_PASSWORD=
# Optional: if set, the app can later be switched to route media through an
# SFU (e.g. LiveKit) instead of mesh P2P without a rewrite of the client API.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- AI moderation & translation & icebreaker generation ---
# Any of these being unset activates the built-in dev/mock provider so the
# app keeps working end-to-end without external credentials.
AI_PROVIDER=mock
AI_API_KEY=
AI_API_BASE_URL=
TRANSLATION_PROVIDER=mock
# Any LibreTranslate-compatible endpoint (self-hosted or hosted), e.g. https://libretranslate.example.com
TRANSLATION_API_BASE_URL=
TRANSLATION_API_KEY=

# --- Email (password reset) ---
# Unset EMAIL_PROVIDER (or missing key/from) => mock provider, which logs
# the email (including the reset link) to the server console instead of
# sending it — password reset still works end-to-end in local dev.
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM=
# Any Resend-compatible HTTP API. Defaults to https://api.resend.com.
EMAIL_API_BASE_URL=

# --- Object storage (S3-compatible) for avatars/media ---
STORAGE_PROVIDER=mock
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=wisp-media
STORAGE_PUBLIC_URL=

# --- Anti-abuse ---
# Cloudflare Turnstile. Unset CAPTCHA_SECRET => mock provider (always passes in dev).
# Set CAPTCHA_PROVIDER=turnstile to enable real verification.
CAPTCHA_PROVIDER=mock
CAPTCHA_SECRET=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# --- Business details (shown in the footer, Terms and Privacy Policy) ---
# Privacy and consumer law require the operator's identity and a contact.
LEGAL_ENTITY_NAME=
LEGAL_ADDRESS=
LEGAL_CONTACT_EMAIL=
# Whose law governs the Terms, e.g. "Spain" or "Delaware, USA".
LEGAL_JURISDICTION=

# --- Ads (Google AdSense) ---
# Off unless NEXT_PUBLIC_ADSENSE_CLIENT is set. Baked into the page at build
# time: rebuild after changing. Ads appear only on the home and games pages.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_LANDING=
NEXT_PUBLIC_ADSENSE_SLOT_GAMES=
# Preview where ads go without an AdSense account (shows labelled empty boxes).
NEXT_PUBLIC_AD_PLACEHOLDERS=false

# --- Rate limits (requests per window) ---
RATE_LIMIT_MESSAGES_PER_10S=15
RATE_LIMIT_MATCH_REQUESTS_PER_MIN=20
RATE_LIMIT_LOGIN_ATTEMPTS_PER_15MIN=10
