# --- connections ---
RPC_URL=https://api.mainnet-beta.solana.com   # use a paid RPC (Helius/Triton/QuickNode) for anything serious
JUPITER_URL=https://lite-api.jup.ag/swap/v1   # free tier is rate limited; paid: https://api.jup.ag/swap/v1
JUPITER_API_KEY=
WALLET=                                        # path to solana-keygen JSON, or base58 secret key. Use a DEDICATED wallet.

# --- mode ---
LIVE=off                                       # off = never sends anything. on = real money.
TICK_MS=1000

# --- strategy: BASE -> X -> BASE in one atomic transaction ---
BASE_MINT=USDC
BASE_DECIMALS=6
TRADE_SIZE=50                                  # whole base units per cycle
INTERMEDIATES=SOL,USDT,JUP,BONK,JTO,WIF       # symbols from src/config.ts or raw mint addresses
MIN_PROFIT=0.02                                # whole base units, AFTER fees
LEG1_SLIPPAGE_BPS=0
MAX_ACCOUNTS_PER_LEG=24

# --- fees / landing ---
COMPUTE_UNIT_LIMIT=600000
PRIORITY_MICROLAMPORTS=20000
JITO=on
JITO_TIP_LAMPORTS=10000
SIMULATE=on

# --- risk ---
MAX_TRADES_PER_MIN=10
DAILY_LOSS_LIMIT_SOL=0.05
MAX_CONSECUTIVE_FAILURES=8
MIN_SOL_BALANCE=0.02
