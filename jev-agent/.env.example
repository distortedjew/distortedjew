# --- Model ---
MODEL=mock                    # mock | jev   (use mock until you have a key)
TYPESAFE_AI_API_KEY=          # from TypeSafe AI, required when MODEL=jev
JEV_MODEL_ID=jev-latest

# --- Markets ---
FEED=sim                      # sim | binance   (binance = public websocket, no key needed)
SYMBOLS=BTCUSDT,ETHUSDT       # binance symbols

# --- Execution (paper only for now) ---
BROKER=paper
START_CASH=10000

# --- Decision thresholds ---
HORIZON_SEC=30                # question asked of Jev: higher or lower after this long?
DECIDE_EVERY_MS=500           # at most one in-flight Jev call per symbol
MIN_CONFIDENCE=0.62           # probability required to act
MAX_LATENCY_MS=1500           # decisions slower than this are discarded as stale

# --- Risk (hard limits, enforced outside the model) ---
MAX_POSITION_USD=1000         # per symbol
MAX_TOTAL_EXPOSURE_USD=3000
MAX_ORDERS_PER_MIN=20
DAILY_LOSS_LIMIT_USD=200      # kill switch: flatten and halt for the day
FEE_BPS=10                    # simulated taker fee
SLIPPAGE_BPS=1

# --- Alpaca paper (free: alpaca.markets -> Paper Trading -> API keys) ---
# FEED=alpaca and BROKER=alpaca to use it. Stocks: AAPL,TSLA   Crypto: BTC/USD,ETH/USD
# This agent only ever talks to paper-api.alpaca.markets.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# --- Dashboard ---
DASHBOARD_PORT=8787
DASHBOARD_HOST=127.0.0.1      # keep local; reach it via SSH tunnel or a TLS reverse proxy
DASHBOARD_TOKEN=              # set this if you expose it beyond localhost
