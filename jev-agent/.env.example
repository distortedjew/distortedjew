# --- Strategy ---
# trend (recommended): daily crypto trend following, backtested (see STRATEGY.md).
# scalp (experimental): intraday Jev + LLM plans; fees make short-horizon trading very hard.
STRATEGY=trend
# candle size: 1d (backtested default) | 4h-fast (~1-60 day trends, ~8x more trades) | 4h-same (1d horizons checked every 4h)
# switch only if `npm run fetch-data -- --interval 4h && npm run backtest -- --compare` says so
TREND_VARIANT=1d
# how much of the account the strategy manages; position sizes are fractions of this
CAPITAL_USD=10000
# portfolio volatility when every trend model is long; the main risk dial (backtest 2018-2026):
#   0.25 -> ~22%/yr, worst drop -16%    0.35 -> ~31%/yr, -21%
#   0.5 (with MAX_WEIGHT=0.5) -> ~45%/yr, -30%    0.7 (MAX_WEIGHT=0.6) -> ~62%/yr, -39%
TARGET_VOL=0.25
# largest share of capital in one coin
MAX_WEIGHT=0.35
# rebalance just after this UTC hour's daily close (0 = right after the daily candle closes)
REBALANCE_UTC_HOUR=0
# each rebalance order is worked over this window in slices, timed by Jev
EXEC_WINDOW_MIN=60
EXEC_SLICES=4
EXEC_CHECK_SEC=20
# Jev must be this sure the price is about to move our way before a slice waits
JEV_WAIT_CONFIDENCE=0.65
# how often the AI risk officer reviews (it can only reduce positions)
AI_REVIEW_EVERY_HOURS=6

# --- Jev news reflex: Jev reads every new headline (~0.3 s each); a severe threat cuts that coin at once ---
NEWS_REFLEX=on
# comma-separated RSS/Atom feeds
NEWS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://decrypt.co/feed,https://www.theblock.co/rss.xml
NEWS_POLL_SEC=60
# ignore headlines older than this (already priced in)
NEWS_MAX_AGE_MIN=30
# Jev must be this sure a headline is "severe" before cutting
NEWS_SEVERE_CONFIDENCE=0.7
# cut the coin to this fraction of its target (0 = sell it all) for this many hours
NEWS_CUT_TO=0
NEWS_CUT_HOURS=12

# --- Jev scorecard: Jev predicts each coin every N seconds without trading; graded after HORIZON_SEC ---
# about 6 coins x 4 calls/min; costs well under $1/day at TypeSafe's $0.042 per million input tokens
SCORECARD=on
SCORECARD_EVERY_SEC=15

# --- Alerts (optional): Telegram bot token from @BotFather, and your chat id ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Model ---
# mock | jev   (use mock until you have a key)
MODEL=mock
# from TypeSafe AI, required when MODEL=jev
TYPESAFE_AI_API_KEY=
JEV_MODEL_ID=jev-latest

# --- Markets ---
# sim | binance | alpaca   (binance = public websocket, no key, high tick rate)
FEED=sim
# if your VPS is in the US: wss://stream.binance.us:9443
BINANCE_WS_URL=wss://stream.binance.com:9443
# binance symbols
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT

# --- AI via OpenRouter ---
# trend: the risk officer (reduce-only cuts). scalp: the strategist that sets intraday plans.
# Every STRATEGY_EVERY_MIN it reads 1m/15m/1h/1d candles, order-book depth, futures funding
# and open interest, optional news, and the agent's own results, then decides per coin:
# long or flat, conviction, size, stop-loss, take-profit, max hold. Jev only times entries inside it.
# Leave OPENROUTER_API_KEY empty to run Jev alone (the original mode).
OPENROUTER_API_KEY=
STRATEGIST_MODEL=stealth/space-bunny-alpha
# comma-separated, tried in order if the main model is down (e.g. a free model is withdrawn)
STRATEGIST_FALLBACK_MODELS=
# free OpenRouter models allow ~50 requests/day without credits; 30 min = 48/day
STRATEGY_EVERY_MIN=30
STRATEGIST_TIMEOUT_SEC=120
# the strategist must be at least this sure before Jev may enter
MIN_CONVICTION=0.6
# Jev can close a position early only when this sure, and only after MIN_HOLD_SEC
EXIT_CONFIDENCE=0.75
MIN_HOLD_SEC=120
# after closing a position, don't re-enter that coin for this long (prevents stop-loss churn)
REENTRY_COOLDOWN_MIN=15
# optional news sentiment (free key at alphavantage.co; free tier ~25 requests/day)
ALPHAVANTAGE_API_KEY=
NEWS_EVERY_MIN=60
# market data for the strategist. US servers: BINANCE_REST_URL=https://api.binance.us
# (futures data is not reachable from the US; the strategist is told it's missing)
BINANCE_REST_URL=https://api.binance.com
BINANCE_FUTURES_URL=https://fapi.binance.com

# --- Execution (paper only for now) ---
BROKER=paper
START_CASH=10000

# --- Decision thresholds ---
# question asked of Jev: higher or lower after this long?
HORIZON_SEC=120
# at most one in-flight Jev call per symbol
DECIDE_EVERY_MS=500
# probability required to act
MIN_CONFIDENCE=0.62
# decisions slower than this are discarded as stale
MAX_LATENCY_MS=1500

# --- Risk (hard limits, enforced outside the model) ---
# With STRATEGY=trend these default from CAPITAL_USD (40% / 100% / 10%); set them only to override.
# per symbol
#MAX_POSITION_USD=4000
#MAX_TOTAL_EXPOSURE_USD=10000
MAX_ORDERS_PER_MIN=20
# kill switch: flatten and halt for the day
#DAILY_LOSS_LIMIT_USD=1000
# Alpaca's minimum; small exits close the whole position instead
MIN_ORDER_USD=10
# simulated taker fee (Alpaca crypto base tier is 0.25%); also tells the strategist the cost
FEE_BPS=25
SLIPPAGE_BPS=1

# --- Alpaca paper (free: alpaca.markets -> Paper Trading -> API keys) ---
# Recommended for crypto: FEED=binance BROKER=alpaca SYMBOLS=BTCUSDT,ETHUSDT (Binance prices, real Alpaca paper fills).
# Stocks need FEED=alpaca BROKER=alpaca SYMBOLS=AAPL,TSLA (the free Alpaca feed is thin; fine for stocks, too slow for crypto).
# This agent only ever talks to paper-api.alpaca.markets.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# --- Dashboard ---
DASHBOARD_PORT=8787
# keep local; reach it via SSH tunnel or a TLS reverse proxy
DASHBOARD_HOST=127.0.0.1
# set this if you expose it beyond localhost
DASHBOARD_TOKEN=
