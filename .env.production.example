# Wisp — production configuration for docker-compose.prod.yml
#
#   cp .env.production.example .env
#
# Fill in every value marked REQUIRED. Never commit the resulting .env.
# Generate each secret with the command shown next to it.

# --- Server (REQUIRED) ---
# Your domain, without https:// — its DNS A record must point at this server.
DOMAIN=wisp.example.com
# This server's public IPv4 address (used by the TURN relay).
PUBLIC_IP=203.0.113.10
# Where Let's Encrypt sends certificate expiry warnings.
ACME_EMAIL=you@example.com

# --- Secrets (REQUIRED) ---
# openssl rand -base64 32
AUTH_SECRET=
# openssl rand -hex 24
POSTGRES_PASSWORD=
# Shared between the app and the TURN relay; each user gets a short-lived
# login derived from it. openssl rand -hex 32
TURN_SECRET=

# --- Session ---
AUTH_COOKIE_NAME=wisp_session
GUEST_SESSION_TTL_DAYS=30
AUTH_SESSION_TTL_DAYS=30

# --- TURN relay port range (open these UDP ports in your firewall) ---
TURN_MIN_PORT=49160
TURN_MAX_PORT=49660

# --- Backups (written to ./backups on the server) ---
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14

# --- Optional services ---
# Each one falls back to a built-in stand-in while left as "mock", so the
# site works without them — but see docs/DEPLOY.md before a public launch.

# Email (verification + password reset). Resend: https://resend.com
# Set EMAIL_PROVIDER=resend and fill in the key and a verified sender.
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM=Wisp <hello@wisp.example.com>
EMAIL_API_BASE_URL=

# Captcha on account sign-up. Cloudflare Turnstile (free).
# Set CAPTCHA_PROVIDER=turnstile. The site key is baked into the page at
# build time: rebuild (up -d --build) after changing it.
CAPTCHA_PROVIDER=mock
CAPTCHA_SECRET=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# AI moderation (on top of the always-on rule engine).
AI_PROVIDER=mock
AI_API_KEY=
AI_API_BASE_URL=

# Translation: any LibreTranslate-compatible API.
TRANSLATION_PROVIDER=mock
TRANSLATION_API_BASE_URL=
TRANSLATION_API_KEY=

# Avatar storage. Leave as mock to keep avatars on this server (in a Docker
# volume). Set STORAGE_PROVIDER=s3 for S3/Cloudflare R2.
STORAGE_PROVIDER=mock
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=wisp-media
STORAGE_PUBLIC_URL=

# --- Ads (Google AdSense) ---
# Off unless NEXT_PUBLIC_ADSENSE_CLIENT is set. Baked into the page at build
# time: rebuild after changing. Ads appear only on the home and games pages.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_LANDING=
NEXT_PUBLIC_ADSENSE_SLOT_GAMES=
# Preview where ads go without an AdSense account (shows labelled empty boxes).
NEXT_PUBLIC_AD_PLACEHOLDERS=false

# --- Rate limits ---
RATE_LIMIT_MESSAGES_PER_10S=15
RATE_LIMIT_MATCH_REQUESTS_PER_MIN=20
RATE_LIMIT_LOGIN_ATTEMPTS_PER_15MIN=10
