# ---- Broker: oanda (Linux/VPS, recommended) or mt5 (Windows + MetaTrader 5 terminal)
BROKER=oanda

# OANDA: free demo at oanda.com -> My Account -> Manage API Access -> generate token
OANDA_TOKEN=
OANDA_ACCOUNT_ID=          # like 101-001-1234567-001
OANDA_ENV=practice         # practice = fake money. "live" also needs LIVE_TRADING=yes
OANDA_INSTRUMENT=XAU_USD

# MetaTrader 5 (Windows only). Leave login empty to use the account already open in the terminal.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=                  # e.g. C:\Program Files\MetaTrader 5\terminal64.exe
MT5_SYMBOL=XAUUSD          # your broker's gold symbol: XAUUSD, XAUUSD.m, GOLD ...
MT5_SERVER_UTC_OFFSET=0    # broker server time minus UTC in hours (often 2 or 3)
MT5_MAGIC=150815

# ---- Safety switch: the bot refuses real-money accounts unless this is "yes"
LIVE_TRADING=no

# ---- Risk
RISK_PER_TRADE=0.005       # 0.5% of equity lost if the stop is hit (max allowed 0.02)
MAX_DAILY_LOSS=0.02        # at -2% on the UTC day: close everything, no trades until tomorrow
MAX_TRADES_PER_DAY=4
MAX_SPREAD=0.60            # USD/oz; skip entries when the spread is wider (news spikes)
MAX_LEVERAGE=10            # position notional never above 10x equity
COOLDOWN_BARS=2

# ---- Optional Telegram alerts (talk to @BotFather for a token; @userinfobot for your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Strategy overrides (defaults shown; change only after backtesting)
# STRAT_SL_ATR=1.5
# STRAT_TP_ATR=3.0
# STRAT_SESSION_START_UTC=7
# STRAT_SESSION_END_UTC=20
# STRAT_MAX_BARS_IN_TRADE=64
