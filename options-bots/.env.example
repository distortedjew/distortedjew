# --- Broker -----------------------------------------------------------------
# alpaca = real Alpaca API (paper by default); sim = offline simulator, no keys needed
BROKER=alpaca
# Paper keys from https://app.alpaca.markets (switch to the Paper account first)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Real money ONLY if this is exactly: I-UNDERSTAND-THIS-IS-REAL-MONEY
# (live keys are different from paper keys; run on paper for weeks first)
ALPACA_LIVE=

# --- Risk -------------------------------------------------------------------
# Share of account equity each bot may tie up (max-loss / collateral)
BOT_ALLOCATION_PCT=0.20
# ORCHARD sells AAPL cash-secured puts: one contract needs strike x 100 in cash (~$25k+)
ORCHARD_ALLOCATION_PCT=0.35
# Max loss of any single spread trade, as a share of equity
RISK_PER_TRADE_PCT=0.02
MAX_CONTRACTS=5
# Stop opening new trades (all bots) once the account is down this much today
DAILY_MAX_LOSS_PCT=0.05

# --- Execution --------------------------------------------------------------
# Seconds to wait at each price step before repricing toward the market
EXEC_WAIT_SEC=45
# How often open positions are checked for exits, seconds
MANAGE_EVERY_SEC=120

# --- Optional ---------------------------------------------------------------
# Free key from alphavantage.co: VOLT and ORCHARD then avoid holding through earnings
ALPHAVANTAGE_API_KEY=

# --- Dashboard --------------------------------------------------------------
# Without a password the dashboard listens on 127.0.0.1 only (use an SSH tunnel).
# With one it listens on all interfaces and asks for this login.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
DASHBOARD_PORT=8080

# --- Phone alerts (optional; set either or both) ----------------------------
# Telegram: message @BotFather -> /newbot -> copy the token. Then send your new bot
# any message and open https://api.telegram.org/bot<TOKEN>/getUpdates to find chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord: Server settings -> Integrations -> Webhooks -> New webhook -> Copy URL
DISCORD_WEBHOOK_URL=
# Don't repeat an identical alert (e.g. the same error) within this many minutes
ALERT_DEDUPE_MIN=30

# --- Small account ($100 - $2,000) -------------------------------------------
# All bots together may put at most this share of equity at risk (1.0 = no extra limit).
ACCOUNT_RISK_CAP_PCT=1.0
# Per-bot overrides: <BOT>_<SETTING>=value, e.g. ATLAS_WIDTH=1, NOVA_MAX_WIDTH=1, ORCHARD_ENABLED=0.
# For a $100 account, uncomment this block (see README "Small accounts" first):
# BOT_ALLOCATION_PCT=0.95
# RISK_PER_TRADE_PCT=0.95
# ACCOUNT_RISK_CAP_PCT=0.95
# MAX_CONTRACTS=1
# DAILY_MAX_LOSS_PCT=0.30
# ATLAS_WIDTH=1
# RANGER_WIDTH=1
# NOVA_MAX_WIDTH=1
# VOLT_MAX_WIDTH=1
# ORCHARD_ENABLED=0
