# AI Trading Bot configuration. Copy to .env (in ai-trading-bot/ or backend/) and edit.
#
# The engine and the API both read this file (tradebot/config.py); real environment
# variables take precedence over it. Everything has a working default: an empty .env runs
# a paper-trading bot on Binance market data (or the simulator when Binance is
# unreachable) with the local heuristic analyst.
#
# Secrets (API keys, bot tokens, webhook URLs, passwords) live only here. They are never
# stored in the database, never shown in the dashboard and never returned by the API,
# which only reports whether each one is configured.
#
# Trading parameters (symbols, strategy, risk limits, AI model, ...) are not set here:
# edit them on the dashboard's Settings page.

# -- Storage -------------------------------------------------------------------------
# SQLite database shared by the engine and the API (created on first start).
# Default: backend/data/tradebot.db
# TRADEBOT_DB=/var/lib/tradebot/tradebot.db

# -- Trading mode --------------------------------------------------------------------
# paper (default) or live. This build only paper trades: "live" makes the engine refuse
# to start, and the dashboard can never switch it on.
TRADING_MODE=paper
# Paper account balance in USDT the bot starts from.
STARTING_BALANCE=10000

# -- Market data ---------------------------------------------------------------------
# auto      Binance, falling back to the simulator if Binance is unreachable (default)
# binance   Binance only; retry with backoff instead of falling back
# simulated deterministic simulated market (no network needed)
FEED=auto
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443
# Random seed of the simulator: the same seed produces the same market.
SIM_SEED=7
# Simulator only, on an empty database: replay this many days of simulated market
# through the real trading core first, so the dashboard opens with a track record.
SIM_BOOTSTRAP_DAYS=14

# -- AI analyst (OpenRouter) -----------------------------------------------------------
# Without a key the local heuristic analyst makes every decision. Get a key at
# https://openrouter.ai/keys; choose the model on the Settings page.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Sent as HTTP-Referer / X-Title so the requests are attributed to this app on OpenRouter.
OPENROUTER_APP_URL=https://github.com/distortedjew/distortedjew
OPENROUTER_APP_NAME=AI Trading Bot

# -- Notifications (optional; enable channels on the Settings page) --------------------
# Telegram: a bot token from @BotFather and the chat id to post to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord: a channel webhook URL (Server Settings -> Integrations -> Webhooks).
DISCORD_WEBHOOK_URL=
# Email over SMTP. Configured when SMTP_HOST and SMTP_FROM are set; the recipient is
# set on the Settings page.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# STARTTLS on connect (true for port 587; set false for a plain local relay).
SMTP_STARTTLS=true

# -- API and dashboard -----------------------------------------------------------------
# Address and port of the API, which also serves the built dashboard (scripts/start.sh).
# Keep 127.0.0.1 unless you need remote access; then set DASHBOARD_TOKEN as well.
API_HOST=127.0.0.1
API_PORT=8000
# When set, the dashboard asks for this token and every API request must carry it
# (Authorization: Bearer <token>, or ?token= on the WebSocket). /api/health stays open.
DASHBOARD_TOKEN=
# Browser origins allowed to call the API cross-origin, comma-separated. Not needed when
# the dashboard is served by the API itself or through the Vite dev proxy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Built dashboard the API serves. Default: dashboard/dist
# DASHBOARD_DIST=/opt/tradebot/dashboard/dist

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
