{
  "name": "tradebot-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "AI Trading Bot dashboard: real-time monitoring terminal for the paper-trading engine",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:types": "node scripts/gen-types.mjs",
    "e2e": "playwright test"
  },
