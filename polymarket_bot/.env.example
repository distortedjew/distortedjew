# Required: Polygon wallet private key (hex, with or without 0x prefix)
PRIVATE_KEY=0xyour_private_key_here

# Optional: Polymarket API credentials (derived from private key if omitted)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Trading parameters
MIN_EDGE=0.05          # Minimum edge (fraction) required to trade
MAX_TRADE_USDC=50.0    # Maximum USDC per trade
KELLY_FRACTION=0.25    # Fraction of Kelly bet to use (0.25 = quarter-Kelly)
MIN_LIQUIDITY=50.0     # Minimum market volume (USDC) to consider
MAX_SPREAD=0.08        # Maximum bid-ask spread to tolerate

# Bot behavior
POLL_INTERVAL_SECONDS=300   # How often to scan markets (seconds)
DRY_RUN=true                # Set to false to place real orders
